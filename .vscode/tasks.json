{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "FinTrack: OpenAI API-kulcs biztonságos beállítása",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-NoLogo",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\.vscode\\configure-openai-secrets.ps1"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Run ExpenseTracker API",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"run",
				"--project",
				"week1\\ExpenseTracker\\backend\\ExpenseTracker.Api"
			],
			"isBackground": true,
			"problemMatcher": [
				"$msCompile"
			]
		},
		{
			"label": "Run FinTrack frontend (Vite)",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"week1\\ExpenseTracker",
				"run",
				"dev",
				"--",
				"--host",
				"127.0.0.1"
			],
			"isBackground": true,
			"problemMatcher": []
		}
	]
}